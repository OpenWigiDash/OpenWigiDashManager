{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "SourceName": "OpenWigiDash",
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  },
  "OpenWigi": {
    "AllowRemoteSessions": false,
    "SessionPollInterval": "00:00:01",
    "ReconnectInterval": "00:00:02",
    "ReconnectMaxInterval": "00:00:30",
    "StableAfter": "00:00:30",
    "ResetAfterFailures": 3
  }
}
