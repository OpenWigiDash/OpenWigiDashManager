<Project Sdk="Microsoft.NET.Sdk">

  <!-- Repete o essencial do Directory.Build.props do repo para o pacote compilar sozinho. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OpenWigi.Sdk</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>victorperez2911.OpenWigi.Sdk</PackageId>
    <!-- A versão publicada vem da tag sdk-vX.Y.Z (workflow sdk-publish.yml). -->
    <Version>2.0.0-preview.1</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/victorperez2911/OpenWigiDashManager</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Authors>Victor Perez</Authors>
    <Product>OpenWigiDashManager</Product>
    <Description>Contratos para escrever widgets do OpenWigiDashManager (.NET 10): widget, instância assíncrona que entrega quadros, toques ricos, contexto do host e tela de configurações em Razor.</Description>
    <PackageTags>wigidash;openwigi;widget;sdk</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Nem todo membro ou parâmetro óbvio precisa de comentário XML. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Os dois chegam ao plugin pelo host (contexto compartilhado); ver OpenWigiSdk.SharedAssemblies. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\sdk.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\assets\branding\png\openwigidash-256.png" Pack="true" PackagePath="icon.png" />
    <!-- Entra no projeto de quem referencia o pacote: com OpenWigiDashPlugin=true, `dotnet pack` gera o pacote de plugin. -->
    <None Include="build\victorperez2911.OpenWigi.Sdk.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenWigi.Sdk.Tests" />
  </ItemGroup>

</Project>

