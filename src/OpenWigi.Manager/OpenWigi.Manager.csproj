<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- O BlazorWebView do WPF usa o controle de composição do WebView2, que precisa da projeção
         do Windows SDK (Microsoft.Windows.SDK.NET): por isso a versão do Windows no TFM. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>OpenWigi.Manager</RootNamespace>
    <AssemblyName>OpenWigiDashManager</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF e WinForms juntos geram ambiguidades nos usings implícitos; listamos os nossos. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\branding\openwigidash.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ícone das janelas (WPF) e os da bandeja, um por estado e tema (assets/branding/README.md). -->
    <Resource Include="..\..\assets\branding\openwigidash.ico" Link="Assets\openwigidash.ico" />
    <EmbeddedResource Include="..\..\assets\branding\tray\*.ico" LogicalName="OpenWigi.Manager.Tray.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenWigi.Host\OpenWigi.Host.csproj" />
    <ProjectReference Include="..\OpenWigi.Ipc\OpenWigi.Ipc.csproj" />
    <ProjectReference Include="..\OpenWigi.Plugins\OpenWigi.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.7" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

</Project>
