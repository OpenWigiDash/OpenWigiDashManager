<Window x:Class="OpenWigi.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:OpenWigi.Manager.Components"
        Title="OpenWigiDash Manager" Width="1280" Height="820" MinWidth="1100" MinHeight="720"
        Background="#121318" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/openwigidash.ico">
    <Grid>
        <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Root}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>

        <!-- Tela de abertura: cobre o WebView2 enquanto ele sobe e o Blazor desenha pela primeira vez,
             nas cores do tema escolhido. O BlazorWebView usa o controle de composição, então dá para
             pôr conteúdo WPF por cima dele. As cores vêm do code-behind (ApplyTheme). -->
        <Grid x:Name="Splash" Background="#121318">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/openwigidash-512.png" Width="144" Height="144"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="SplashTitle" Text="OpenWigiDash Manager" HorizontalAlignment="Center"
                           Margin="0,16,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22"
                           FontWeight="SemiBold" Foreground="#E8E9ED" />
                <ProgressBar x:Name="SplashProgress" IsIndeterminate="True" Width="168" Height="3"
                             Margin="0,20,0,0" BorderThickness="0" Foreground="#E5243B" Background="#24262E" />
                <!-- Só aparece se o WebView2 não terminar de abrir (ver OnSplashTimeout). -->
                <StackPanel x:Name="SplashStuck" Visibility="Collapsed" Margin="0,24,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="SplashStuckText" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="420" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="14"
                               Foreground="#E8E9ED"
                               Text="A janela está demorando para abrir. O painel no aparelho continua funcionando." />
                    <Button x:Name="SplashRetry" Content="Tentar de novo" HorizontalAlignment="Center"
                            Margin="0,14,0,0" Padding="16,6" Click="OnRetryClick" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Capa da volta do tray (e de minimizado): escondida, a janela para de desenhar o WebView2. Ela
             entra antes do Hide() e sai quando ele já voltou a pintar (ver OnClosing e OnShownAgain). É uma
             versão menor da tela de abertura: logo e a barra de progresso, nas cores do tema. -->
        <Grid x:Name="Cover" Background="#121318" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/openwigidash-512.png" Width="96" Height="96"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <ProgressBar x:Name="CoverProgress" IsIndeterminate="True" Width="120" Height="3"
                             Margin="0,16,0,0" BorderThickness="0" Foreground="#E5243B" Background="#24262E" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
