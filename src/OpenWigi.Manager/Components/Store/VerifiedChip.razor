@* Selo de confiança: Oficial (conta do projeto), Verificado (lista revisada) ou Comunidade. *@
@switch (Trust)
{
    case PluginTrust.Official:
        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Verified" Class="ma-0"
                 title="Publicado pela conta do OpenWigiDash no nuget.org">Oficial</MudChip>
        break;
    case PluginTrust.Verified:
        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Verified" Class="ma-0"
                 title="Revisado pelos mantenedores do OpenWigiDash">Verificado</MudChip>
        break;
    default:
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0"
                 title="Código não revisado pelo OpenWigiDash">Comunidade</MudChip>
        break;
}

@code {
    [Parameter] public PluginTrust Trust { get; set; }
}
