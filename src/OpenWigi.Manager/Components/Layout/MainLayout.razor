@inherits LayoutComponentBase
@implements IDisposable
@inject ManagerSettings Settings
@inject AgentClient Agent
@inject NavigationManager Navigation
@inject PluginStore Store
@inject AppUpdates Updates
@inject DashboardHost Dashboard

@* Tema só pela preferência do manager: sem seguir o Windows (ObserveSystemDarkModeChange), que na
   primeira renderização trocava para claro por conta própria e deixava a tela misturada. O bind
   de volta grava qualquer troca que o próprio MudBlazor fizer, para os dois lados não divergirem. *@
<MudThemeProvider Theme="_theme" @bind-IsDarkMode="DarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Color="Color.Primary" Class="mr-3" />
        <MudText Typo="Typo.h6">OpenWigiDash Manager</MudText>
        <MudSpacer />
        <StatusChip />
    </MudAppBar>
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0" ClipMode="DrawerClipMode.Always">
        <MudNavMenu Class="mt-2">
            <MudNavLink Href="/widgets" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.GridView">Widgets e páginas</MudNavLink>
            <MudNavLink Href="/loja" Icon="@Icons.Material.Filled.Storefront">
                <div class="d-flex align-center">
                    Loja de plugins
                    @if (Store.UpdateCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2 my-0" title="Plugins com atualização">@Store.UpdateCount</MudChip>
                    }
                </div>
            </MudNavLink>
            <MudNavLink Href="/ajustes" Icon="@Icons.Material.Filled.Tune">
                <div class="d-flex align-center">
                    Ajustes
                    @if (Updates.Available is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2 my-0" title="Versão nova do OpenWigiDash">Nova versão</MudChip>
                    }
                </div>
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-4">
            @if (PackageContext.PackageFamilyName is { } package)
            {
                @* Aberto de dentro de um app da Store: o que gravar aqui vai para a cópia daquele app (PackageContext). *@
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    O OpenWigiDash foi aberto de dentro de outro app (@package). Nesse modo o Windows grava páginas, ajustes
                    e plugins numa cópia separada, em <code>@PackageContext.RedirectedAppData</code>, que o OpenWigiDash
                    aberto pelo menu Iniciar não enxerga. Feche pela bandeja e abra pelo menu Iniciar.
                </MudAlert>
            }
            @if (Dashboard.LayoutProblem is { } problem && !_layoutProblemDismissed)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _layoutProblemDismissed = true">
                    @problem
                </MudAlert>
            }
            @* Erro numa tela não derruba a janela inteira: mostra o aviso e deixa navegar para outra. *@
            <ErrorBoundary @ref="_errors">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="error">
                    <MudAlert Severity="Severity.Error" Class="mb-4">
                        Esta tela encontrou um erro: @error.Message
                        <MudButton Size="Size.Small" Variant="Variant.Text" Class="ml-2" OnClick="() => _errors?.Recover()">Tentar de novo</MudButton>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _layoutProblemDismissed;
    private ErrorBoundary? _errors;
    private readonly MudTheme _theme = OpenWigi.Manager.Theming.OpenWigiDashTheme.Create();

    private bool DarkMode
    {
        get => Settings.DarkMode;
        set
        {
            if (Settings.DarkMode != value)
                Settings.DarkMode = value;
        }
    }

    protected override void OnInitialized()
    {
        Settings.Changed += Refresh;
        Store.Changed += Refresh;
        Updates.Changed += Refresh;
        Settings.NavigationRequested += Navigate;
        if (Settings.PendingRoute is { } route)
        {
            Settings.PendingRoute = null;
            Navigation.NavigateTo(route);
        }
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void Navigate(string route) => InvokeAsync(() => Navigation.NavigateTo(route));

    public void Dispose()
    {
        Settings.Changed -= Refresh;
        Store.Changed -= Refresh;
        Updates.Changed -= Refresh;
        Settings.NavigationRequested -= Navigate;
    }
}
