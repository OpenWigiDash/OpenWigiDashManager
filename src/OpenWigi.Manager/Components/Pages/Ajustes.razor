@page "/ajustes"
@inject ManagerSettings Settings
@inject AgentClient Agent
@implements IDisposable

<MudStack Spacing="4" Style="max-width: 720px">
    <MudText Typo="Typo.h5">Ajustes</MudText>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Aparelho</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">Brilho da tela agora (não fica gravado no aparelho).</MudText>
        <MudSlider T="int" Value="Brightness" ValueChanged="SetBrightness" Min="5" Max="100" Step="5"
                   Disabled="@(Agent.Status != AgentStatus.Owner)" Color="Color.Primary">@Brightness%</MudSlider>
        @if (Agent.Status != AgentStatus.Owner)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Disponível quando a tela estiver com você.</MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Este usuário</MudText>
        <MudSwitch T="bool" Value="Settings.StartWithWindows" ValueChanged="v => Settings.StartWithWindows = v" Color="Color.Primary">
            Abrir o OpenWigiDash ao entrar no Windows (no tray)
        </MudSwitch>
        <MudSwitch T="bool" Value="Settings.DarkMode" ValueChanged="v => Settings.DarkMode = v" Color="Color.Primary">
            Tema escuro
        </MudSwitch>
    </MudPaper>
</MudStack>

@code {
    // Antes do serviço informar o brilho real, o cursor fica no padrão de fábrica do WigiDash.
    private int Brightness => Agent.Brightness ?? 50;

    protected override void OnInitialized() => Agent.Changed += OnAgentChanged;

    public void Dispose() => Agent.Changed -= OnAgentChanged;

    private void OnAgentChanged() => InvokeAsync(StateHasChanged);

    private Task SetBrightness(int value) => Agent.SetBrightnessAsync(value);
}
