@page "/ajustes"
@inject ManagerSettings Settings
@inject AgentClient Agent
@inject AppUpdates Updates
@inject DashboardHost Host
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@implements IDisposable

<MudStack Spacing="4" Style="max-width: 720px">
    <MudText Typo="Typo.h5">Ajustes</MudText>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Aparelho</MudText>
        <MudSelect T="DeviceKind" Label="Aparelho ativo" Value="Agent.Device.Kind" ValueChanged="SelectDevice"
                   Variant="Variant.Outlined" Dense="true" Disabled="@(Agent.Status is AgentStatus.NoService)" Class="mb-1">
            <MudSelectItem Value="DeviceKind.Usb">@UsbLabel</MudSelectItem>
            <MudSelectItem Value="DeviceKind.Virtual">WigiDash virtual</MudSelectItem>
        </MudSelect>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
            O virtual é para quem não tem o aparelho: a tela aparece na prévia e o mouse nela vira toque.
            A escolha vale para todos os usuários deste PC. Com a tela em outra sessão, só quem está com ela troca.
        </MudText>
        <MudSwitch T="bool" Value="@(Agent.ShowSessionsOnServiceScreen ?? true)" ValueChanged="SetShowSessions" Color="Color.Primary"
                   Disabled="@(Agent.ShowSessionsOnServiceScreen is null)">
            Mostrar as sessões abertas na tela de bloqueio do WigiDash
        </MudSwitch>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
            Com o PC bloqueado, o WigiDash mostra o nome e a foto de quem tem sessão aberta e se ela está ativa pelo
            acesso remoto. Vale para todos os usuários deste PC.
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-2">Brilho da tela agora (não fica gravado no aparelho).</MudText>
        <MudSlider T="int" Value="Brightness" ValueChanged="SetBrightness" Min="5" Max="100" Step="5"
                   Disabled="@(Agent.Status != AgentStatus.Owner)" Color="Color.Primary">@Brightness%</MudSlider>
        @if (Agent.Status != AgentStatus.Owner)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Disponível quando a tela estiver com você.</MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Este usuário</MudText>
        <MudSwitch T="bool" Value="Settings.StartWithWindows" ValueChanged="v => Settings.StartWithWindows = v" Color="Color.Primary">
            Abrir o OpenWigiDash ao entrar no Windows (no tray)
        </MudSwitch>
        <MudSwitch T="bool" Value="Settings.DarkMode" ValueChanged="v => Settings.DarkMode = v" Color="Color.Primary">
            Tema escuro
        </MudSwitch>
        <MudSwitch T="bool" Value="Settings.CheckPluginUpdates" ValueChanged="v => Settings.CheckPluginUpdates = v" Color="Color.Primary">
            Procurar atualizações dos plugins uma vez por dia
        </MudSwitch>
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Layout</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            Guarde uma cópia das páginas e dos widgets, com as configurações de cada um, ou volte a uma cópia guardada.
        </MudText>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ExportLayout" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.SaveAlt">Exportar cópia...</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="RestoreFromFile" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.Restore">Restaurar de arquivo...</MudButton>
        </MudStack>

        <MudText Typo="Typo.body2" Class="mt-4 mb-1">Cópias automáticas</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
            O manager guarda uma cópia do layout ao abrir e antes de cada restauração (as 10 mais novas). Elas têm só as
            páginas e as posições: widgets tirados depois da cópia voltam com as configurações padrão.
        </MudText>
        @if (_backups.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Ainda não há cópias.</MudText>
        }
        else
        {
            <MudList T="string" Dense="true" Class="py-0">
                @foreach (var backup in _backups)
                {
                    <MudListItem T="string">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">@BackupLabel(backup)</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="_busy"
                                       OnClick="() => RestoreBackup(backup)">Restaurar</MudButton>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="OpenBackupFolder" Class="mt-1"
                   StartIcon="@Icons.Material.Filled.FolderOpen">Abrir a pasta das cópias</MudButton>
    </MudPaper>

    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Sobre</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">OpenWigiDash Manager @AppVersion.Display</MudText>
        @if (Updates.Available is { } release)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                <MudText Typo="Typo.body2"><b>@release.Name</b> está disponível@(release.IsPrerelease ? " (versão de teste)" : "").</MudText>
                @if (Updates.CanInstall)
                {
                    <MudText Typo="Typo.caption" Class="d-block mb-2">
                        O OpenWigiDash baixa a versão nova, fecha, o Windows pede permissão de administrador e ele abre de novo
                        quando terminar. Layout, ajustes e plugins continuam.
                    </MudText>
                    @if (Updates.DownloadProgress is { } progress)
                    {
                        <MudProgressLinear Color="Color.Primary" Value="@(progress * 100)" Class="mb-2" />
                        <MudText Typo="Typo.caption" Class="d-block mb-2">Baixando... @((int)(progress * 100))%</MudText>
                    }
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Install"
                                   Disabled="@(Updates.DownloadProgress is not null)" StartIcon="@Icons.Material.Filled.Download">Atualizar agora</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="Updates.OpenReleasePage"
                                   StartIcon="@Icons.Material.Filled.OpenInNew">Ver novidades</MudButton>
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="d-block mb-2">
                        Baixe o OpenWigiDash-Setup.exe na página da versão e rode: ele atualiza por cima, sem perder layout e plugins.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Updates.OpenReleasePage"
                               StartIcon="@Icons.Material.Filled.OpenInNew">Ver novidades e baixar</MudButton>
                }
                @if (_installError is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block mt-2">Não deu para atualizar: @_installError</MudText>
                }
            </MudAlert>
        }
        <MudSwitch T="bool" Value="Settings.CheckAppUpdates" ValueChanged="v => Settings.CheckAppUpdates = v" Color="Color.Primary">
            Procurar versão nova do OpenWigiDash uma vez por dia
        </MudSwitch>
        <MudSwitch T="bool" Value="Settings.BetaAppUpdates" ValueChanged="SetBeta" Color="Color.Primary">
            Avisar também das versões de teste (beta)
        </MudSwitch>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CheckNow" Disabled="@(_checking || !AppUpdates.Supported)"
                       StartIcon="@Icons.Material.Filled.Refresh">Procurar agora</MudButton>
            @if (_checking)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            <MudText Typo="Typo.caption" Color="Color.Secondary">@CheckStatus</MudText>
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
            A checagem só lê a lista de versões no GitHub (api.github.com); nada sobre você ou este PC é enviado.
        </MudText>
    </MudPaper>
</MudStack>

@code {
    // Antes do serviço informar o brilho real, o cursor fica no padrão de fábrica do WigiDash.
    private int Brightness => Agent.Brightness ?? 50;

    private bool _checking;
    private string? _checkError;

    private const string LayoutFilter = "Cópia do layout (*.zip;*.json)|*.zip;*.json|Todos os arquivos (*.*)|*.*";
    private IReadOnlyList<string> _backups = [];
    private bool _busy;

    private void LoadBackups()
    {
        try
        {
            _backups = Host.LayoutBackups();
        }
        catch (System.IO.IOException)
        {
            _backups = [];
        }
    }

    // layout-20261101-180257.json -> "01/11/2026 18:02:57"
    private static string BackupLabel(string path)
    {
        var name = System.IO.Path.GetFileNameWithoutExtension(path);
        return DateTime.TryParseExact(name.Replace("layout-", ""), "yyyyMMdd-HHmmss", null,
            System.Globalization.DateTimeStyles.None, out var when)
            ? when.ToString("dd/MM/yyyy HH:mm:ss")
            : name;
    }

    private async Task ExportLayout()
    {
        var path = FilePicker.Save("Exportar cópia do layout", "Cópia do layout (*.zip)|*.zip",
            LayoutArchive.SuggestedFileName(DateTimeOffset.Now));
        if (path is null)
            return;
        _busy = true;
        try
        {
            await Host.ExportLayoutAsync(path);
            Snackbar.Add($"Cópia do layout gravada em {path}.", Severity.Success);
        }
        catch (Exception ex) when (ex is System.IO.IOException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Não deu para gravar a cópia: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task RestoreFromFile()
    {
        var path = FilePicker.Open("Restaurar layout", LayoutFilter);
        return path is null ? Task.CompletedTask : RestoreAsync(path, System.IO.Path.GetFileName(path));
    }

    private Task RestoreBackup(string path) => RestoreAsync(path, $"a cópia de {BackupLabel(path)}");

    private async Task RestoreAsync(string path, string what)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Restaurar o layout?",
            $"As páginas e os widgets de agora serão trocados pelos de {what}. Antes, o layout atual vira uma cópia " +
            "automática, então dá para voltar a ele.", yesText: "Restaurar", cancelText: "Cancelar");
        if (confirmed != true)
            return;
        _busy = true;
        try
        {
            await Host.RestoreLayoutAsync(path);
            Snackbar.Add("Layout restaurado.", Severity.Success);
        }
        catch (System.IO.InvalidDataException ex)
        {
            Snackbar.Add($"Não deu para restaurar: {ex.Message}", Severity.Error);
        }
        catch (Exception ex) when (ex is System.IO.IOException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Não deu para ler o arquivo: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
            LoadBackups();
        }
    }

    private void OpenBackupFolder()
    {
        System.IO.Directory.CreateDirectory(Host.LayoutBackupDirectory);
        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(Host.LayoutBackupDirectory) { UseShellExecute = true })?.Dispose();
    }

    protected override void OnInitialized()
    {
        Agent.Changed += OnAgentChanged;
        Updates.Changed += OnAgentChanged;
        LoadBackups();
    }

    public void Dispose()
    {
        Agent.Changed -= OnAgentChanged;
        Updates.Changed -= OnAgentChanged;
    }

    private string CheckStatus =>
        !AppUpdates.Supported ? "Esta build não tem versão para comparar."
        : _checkError is not null ? $"Não deu para procurar: {_checkError}"
        : _checking ? "Procurando..."
        : Settings.LastAppUpdateCheck is not { } last ? "Ainda não procurou."
        : Updates.Available is null ? $"Você está na versão mais nova (procurou {last.ToLocalTime():dd/MM HH:mm})."
        : $"Procurou {last.ToLocalTime():dd/MM HH:mm}.";

    private async Task CheckNow()
    {
        _checking = true;
        _checkError = null;
        try
        {
            await Updates.CheckAsync();
        }
        catch (Exception ex)
        {
            _checkError = ex.Message;
        }
        finally
        {
            _checking = false;
        }
    }

    private string? _installError;

    private async Task Install()
    {
        _installError = null;
        try
        {
            await Updates.InstallAsync();
        }
        catch (Exception ex)
        {
            _installError = ex.Message;
        }
    }

    private Task SetBeta(bool value)
    {
        Settings.BetaAppUpdates = value;
        return CheckNow();
    }

    private void OnAgentChanged() => InvokeAsync(StateHasChanged);

    private Task SetBrightness(int value) => Agent.SetBrightnessAsync(value);

    private string UsbLabel => Agent.Device.UsbPresent || Agent.Device is { Kind: DeviceKind.Usb, Connected: true }
        ? "WigiDash (USB)"
        : "WigiDash (USB) — desconectado";

    private Task SelectDevice(DeviceKind kind) => Agent.SelectDeviceAsync(kind);

    private Task SetShowSessions(bool show) => Agent.SetShowSessionsOnServiceScreenAsync(show);
}
