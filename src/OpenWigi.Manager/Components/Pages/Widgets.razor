@page "/"
@page "/widgets"
@implements IAsyncDisposable
@using OpenWigi.Host.Plugins
@using OpenWigi.Host.Display
@inject AgentClient Agent
@inject ManagerSettings Settings
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject PluginStore Store

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <div class="flex-grow-1">
            <MudText Typo="Typo.h5">Widgets e páginas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Monte cada página na grade do WigiDash (10 colunas por 8 linhas de meias células). Arraste um widget para movê-lo; selecione para configurar ou tirar.
            </MudText>
        </div>
        <MudButton StartIcon="@Icons.Material.Filled.OpenInNew" Variant="Variant.Outlined" OnClick="Settings.RequestPreviewWindow">
            Destacar prévia
        </MudButton>
    </MudStack>

    @* O que era o Painel: estado do aparelho e da tela, numa faixa compacta. *@
    <MudPaper Class="px-3 py-2" Outlined="true">
        <MudGrid Spacing="1">
            <MudItem xs="12" sm="4" Class="owd-ellipsis">
                <MudText Typo="Typo.body2" Class="owd-ellipsis">
                    <span class="owd-muted">Aparelho </span>@DeviceLabel
                    @if (Agent.Device is { Connected: true, Kind: DeviceKind.Usb })
                    {
                        <span class="owd-muted" title="Firmware @Agent.Device.Firmware"> · @Agent.Device.Firmware</span>
                    }
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="owd-ellipsis"><span class="owd-muted">Tela </span>@Agent.Reason</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Class="owd-ellipsis">
                    <span class="owd-muted">No aparelho </span>Página @(Dashboard.CurrentPage + 1) de @Dashboard.Layout.Pages.Count
                    — @Dashboard.Layout.Pages.ElementAtOrDefault(Dashboard.CurrentPage)?.Name
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>
    @foreach (var (plugin, reason) in Store.BlockedInstalled)
    {
        <MudAlert Severity="Severity.Error" Dense="true">
            @(plugin.PackageId) @(plugin.Version) foi bloqueada pelos mantenedores: @reason
            <MudLink Href="/loja" Class="ml-1">Atualizar ou remover na Loja</MudLink>
        </MudAlert>
    }
    @if (Store.RestartNeeded)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            <div class="d-flex align-center flex-wrap gap-3">
                <span>As mudanças nos plugins valem quando o manager reabrir.</span>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="Store.RequestRestart">Reiniciar agora</MudButton>
            </div>
        </MudAlert>
    }
    @if (Dashboard.PluginErrors.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            @Dashboard.PluginErrors.Count plugin(s) não carregaram:
            @string.Join("; ", Dashboard.PluginErrors.Select(e => $"{System.IO.Path.GetFileName(e.PluginDirectory)}: {e.Reason}"))
        </MudAlert>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-3" Outlined="true">
                @* Barra do Canvas: a página que está nele, nomes por cima da prévia e o "Adicionar widget". *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mb-2">
                    <MudText Typo="Typo.h6" Class="flex-grow-1 owd-ellipsis">@CurrentPage?.Name</MudText>
                    <MudSwitch T="bool" Value="Settings.ShowWidgetNames" ValueChanged="v => Settings.ShowWidgetNames = v"
                               Color="Color.Primary" Size="Size.Small">Mostrar nomes</MudSwitch>
                    <MudButton StartIcon="@Icons.Material.Filled.Widgets" Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAddWidget">
                        Adicionar widget
                    </MudButton>
                </MudStack>
                @* Arrastar com eventos de ponteiro, não com o drag and drop do HTML: o WebView2 do WPF (controle
                   de composição) não entrega o arrastar nativo do Windows, e por RDP ele simplesmente não acontece. *@
                <div class="owd-grid owd-canvas @(_dragging is null ? "" : "dragging") @(_resizing is null ? "" : "resizing")" @ref="_grid"
                     style="@PageStyle(CurrentPage)"
                     @onpointermove="Move" @onpointerup="Release" @onpointerleave="Cancel">
                    @foreach (var cell in FreeCells())
                    {
                        <div class="owd-cell-empty" style="grid-column: @(cell.Column + 2); grid-row: @(cell.Row + 2)"></div>
                    }
                    @foreach (var placement in CurrentPage?.Widgets ?? [])
                    {
                        var p = placement;
                        <div @key="p.InstanceId" class="owd-widget @(p.InstanceId == _selected ? "selected" : "") @(p.InstanceId == _dragging?.InstanceId ? "ghost" : "")"
                             style="grid-column: @(p.Column + 2) / span @p.Size.Columns; grid-row: @(p.Row + 2) / span @p.Size.Rows; @TileStyle(p, CurrentPage)"
                             @onpointerdown="e => Press(p, e)"
                             @onclick="() => _selected = p.InstanceId">
                            @* O tile mostra o que o widget desenha, com a moldura da página, como vai aparecer no aparelho. *@
                            <div class="owd-tile"><WidgetLiveFrame Dashboard="Dashboard" InstanceId="p.InstanceId" /></div>
                            @if (Dashboard.ProblemOf(p.InstanceId) is { } problem)
                            {
                                @* Sem isso o tile fica vazio, e não dá para saber que o plugin saiu ou não funciona nesta versão.
                                   O nome do widget e o do plugin ficam sempre à vista (mesmo com "Mostrar nomes" desligado):
                                   é o que diz o que reinstalar ou atualizar para o widget voltar. *@
                                <div class="owd-widget-problem" title="@ProblemDetail(problem)">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                                    <span class="owd-widget-problem-title">@ProblemTitle(problem)</span>
                                    <span class="owd-widget-problem-name">@ProblemWidget(p, problem)</span>
                                    <span class="owd-widget-problem-plugin">@ProblemPlugin(problem)</span>
                                </div>
                            }
                            else
                            {
                                <div class="owd-widget-label @(Settings.ShowWidgetNames || p.InstanceId == _selected ? "" : "hidden")">
                                    <MudText Typo="Typo.subtitle2">@Dashboard.DisplayNameOf(p.InstanceId)</MudText>
                                    <MudText Typo="Typo.caption" Class="owd-widget-caption">@(p.Name is { Length: > 0 } && Dashboard.NameOf(p.InstanceId) is { } type && type != p.Name ? $"{type} · {p.Size}" : p.Size.ToString())</MudText>
                                </div>
                            }
                            @if (SizesOf(p.WidgetId).Count > 1)
                            {
                                @* Alça do canto: puxar redimensiona, como uma janela. *@
                                <div class="owd-resize" title="Arraste para mudar o tamanho"
                                     @onpointerdown="e => StartResize(p, e)" @onpointerdown:stopPropagation="true"
                                     @onclick:stopPropagation="true"></div>
                            }
                        </div>
                    }
    
                    @if (_resizing is { } resized && _resizeTo is { } newSize)
                    {
                        <div class="owd-drop @(ResizeAllowed(resized, newSize) ? "ok" : "bad")"
                             style="grid-column: @(resized.Column + 2) / span @newSize.Columns; grid-row: @(resized.Row + 2) / span @newSize.Rows">
                            <span class="owd-drop-label">@newSize</span>
                        </div>
                    }
    
                    @if (_dragging is { } dragged)
                    {
                        if (_hover is { } over && !Fits(dragged, over) && SwapTarget(dragged, over) is { } other)
                        {
                            @* Em cima de outro do mesmo tamanho: os dois trocam de lugar. *@
                            <div class="owd-drop ok"
                                 style="grid-column: @(other.Column + 2) / span @dragged.Size.Columns; grid-row: @(other.Row + 2) / span @dragged.Size.Rows">
                                <span class="owd-drop-label">Trocar</span>
                            </div>
                        }
                        else if (_hover is { } target)
                        {
                            var c = Math.Clamp(target.Column, 0, WidgetGrid.Columns - dragged.Size.Columns);
                            var r = Math.Clamp(target.Row, 0, WidgetGrid.Rows - dragged.Size.Rows);
                            <div class="owd-drop @(Fits(dragged, target) ? "ok" : "bad")"
                                 style="grid-column: @(c + 2) / span @dragged.Size.Columns; grid-row: @(r + 2) / span @dragged.Size.Rows"></div>
                        }
                    }
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                    Arraste um widget para outra posição (em cima de outro do mesmo tamanho, os dois trocam de lugar),
                    ou puxe o canto inferior direito para mudar o tamanho:
                    a área verde mostra como ele fica (vermelha = não cabe ou o widget não tem esse tamanho).
                </MudText>
            </MudPaper>
        </MudItem>

        @* Painel do widget: acompanha a rolagem e rola por dentro, para plugin com muitos campos não quebrar a tela. *@
        <MudItem xs="12" md="4">
            <div class="owd-side">
                @if (Selected is { } selected)
                {
                    var settings = Dashboard.GetSettings(selected.InstanceId);
                    <MudPaper Class="pa-3 mb-4" Outlined="true">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Selecionado</MudText>
                        <MudText Typo="Typo.h6" Class="owd-ellipsis">@Dashboard.DisplayNameOf(selected.InstanceId)</MudText>
                        @if (Dashboard.ProblemOf(selected.InstanceId) is { } selectedProblem)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2">
                                <MudText Typo="Typo.body2"><b>@ProblemTitle(selectedProblem)</b></MudText>
                                <MudText Typo="Typo.caption" Class="d-block mb-2">@ProblemDetail(selectedProblem)</MudText>
                                @if (selectedProblem.Kind != WidgetProblemKind.InstanceFailed)
                                {
                                    <MudText Typo="Typo.caption" Class="d-block mb-2">
                                        Widget <b>@(selectedProblem.WidgetName ?? "desconhecido")</b>
                                        do plugin <b>@(selectedProblem.PluginFolder ?? "desconhecido")</b>.
                                        Ele continua no layout, com as configurações, até você tirar.
                                    </MudText>
                                }
                                <div class="d-flex flex-wrap gap-2">
                                    @if (selectedProblem.PluginFolder is { } folder && Store.UpdateFor(folder) is { } update)
                                    {
                                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Warning" Disabled="_updatingPlugin"
                                                   StartIcon="@Icons.Material.Filled.SystemUpdateAlt"
                                                   OnClick="() => UpdatePlugin(folder)">Atualizar plugin para @update</MudButton>
                                    }
                                    <MudButton Href="@StoreLink(selectedProblem)" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning"
                                               StartIcon="@Icons.Material.Filled.Storefront">
                                        @(selectedProblem.PluginFolder is null ? "Abrir a Loja" : selectedProblem.Kind == WidgetProblemKind.NotInstalled ? "Reinstalar pela Loja" : "Procurar na Loja")
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                        @* Abas: o que todo widget tem (Geral) e as configurações do plugin, quando ele tem. *@
                        <MudTabs @bind-ActivePanelIndex="_sideTab" Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pt-3" MinimumTabWidth="0px"
                                 Class="owd-side-tabs">
                            <MudTabPanel Text="Geral">
                                @* Nome da instância: o sugerido ao adicionar, editável; vazio volta ao nome do widget. *@
                                <MudTextField T="string" @key="selected.InstanceId" Value="@Dashboard.DisplayNameOf(selected.InstanceId)"
                                              ValueChanged="name => Dashboard.RenameWidgetAsync(selected.InstanceId, name)" DebounceInterval="500"
                                              Label="Nome" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              HelperText="@($"{Dashboard.NameOf(selected.InstanceId) ?? "Widget não instalado"} · coluna {selected.Column + 1}, linha {selected.Row + 1}, {selected.Size}")" />
                                @if (SizesOf(selected.WidgetId) is { Count: > 1 } sizes)
                                {
                                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-3 d-block">Tamanho (colunas × linhas)</MudText>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var size in sizes)
                                        {
                                            var s = size;
                                            var fits = FitsAt(selected, selected.Column, selected.Row, s);
                                            <MudChip T="string" Size="Size.Small" Variant="@(s == selected.Size ? Variant.Filled : Variant.Outlined)"
                                                     Color="@(s == selected.Size ? Color.Primary : Color.Default)" Disabled="@(!fits && s != selected.Size)"
                                                     OnClick="() => Resize(selected.InstanceId, s)">@s</MudChip>
                                        }
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tamanhos apagados não cabem a partir desta posição: mova o widget antes.</MudText>
                                }
                                <MudStack Row="true" Class="mt-3">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                               OnClick="() => Remove(selected.InstanceId)">Tirar</MudButton>
                                </MudStack>
                            </MudTabPanel>
                            <MudTabPanel Text="Configurações" Disabled="@(settings is null)"
                                         ToolTip="@(settings is null ? "Este widget não tem configurações" : null)">
                                @* Configurações do próprio plugin: o que mudar aqui já aparece no tile. *@
                                @if (settings is { } plugin)
                                {
                                    <div @key="@($"settings-{selected.InstanceId}")" class="owd-widget-settings">
                                        <CascadingValue Value="plugin.Context">
                                            <DynamicComponent Type="plugin.Component" Parameters="@(new Dictionary<string, object> { ["Instance"] = plugin.Instance })" />
                                        </CascadingValue>
                                    </div>
                                }
                            </MudTabPanel>
                        </MudTabs>
                    </MudPaper>
                }
    
                else
                {
                    <MudPaper Class="pa-4 mb-4" Outlined="true">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Clique num widget da grade para configurar, mudar o tamanho ou tirar.
                            Para pôr um novo, use "Adicionar widget".
                        </MudText>
                    </MudPaper>
                }

                @if (CurrentPage is { } framed)
                {
                    var frame = framed.Frame;
                    @* Moldura dos tiles desta página: valores fixos do SDK, para os plugins saberem todos os tamanhos possíveis. *@
                    <MudPaper Class="pa-3" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="flex-grow-1">Moldura da página</MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(frame == TileFrame.Default)"
                                       OnClick="() => SetFrame(TileFrame.Default)">Padrão</MudButton>
                        </MudStack>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">Espaço entre os tiles</MudText>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var option in TileFrame.SpacingOptions)
                            {
                                var o = option;
                                <MudChip T="string" Size="Size.Small" Variant="@(o == frame.Spacing ? Variant.Filled : Variant.Outlined)"
                                         Color="@(o == frame.Spacing ? Color.Primary : Color.Default)"
                                         OnClick="() => SetFrame(frame with { Spacing = o })">@(o == 0 ? "Sem espaço" : $"{o} px")</MudChip>
                            }
                        </div>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Borda</MudText>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var option in TileFrame.BorderOptions)
                            {
                                var o = option;
                                <MudChip T="string" Size="Size.Small" Variant="@(o == frame.Border ? Variant.Filled : Variant.Outlined)"
                                         Color="@(o == frame.Border ? Color.Primary : Color.Default)"
                                         OnClick="() => SetFrame(frame with { Border = o })">@(o == 0 ? "Sem borda" : $"{o} px")</MudChip>
                            }
                        </div>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Cantos</MudText>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var rounded in new[] { false, true })
                            {
                                var r = rounded;
                                <MudChip T="string" Size="Size.Small" Variant="@(r == frame.Rounded ? Variant.Filled : Variant.Outlined)"
                                         Color="@(r == frame.Rounded ? Color.Primary : Color.Default)"
                                         OnClick="() => SetFrame(frame with { Rounded = r })">@(r ? "Arredondados" : "Retos")</MudChip>
                            }
                        </div>

                        <div class="owd-frame-colors mt-3">
                            <label class="owd-color" title="Cor do fundo da página, entre os tiles">
                                <input type="color" value="@frame.Background.ToString()" aria-label="Cor do fundo"
                                       @onchange="e => SetColor(e, (f, c) => f with { Background = c })" />
                                <span>Fundo</span>
                            </label>
                            <label class="owd-color @(frame.Border == 0 ? "off" : "")" title="Cor da borda dos tiles">
                                <input type="color" value="@frame.BorderColor.ToString()" aria-label="Cor da borda" disabled="@(frame.Border == 0)"
                                       @onchange="e => SetColor(e, (f, c) => f with { BorderColor = c })" />
                                <span>Borda</span>
                            </label>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                            Cada widget perde @(frame.Inset) px de cada lado para a moldura. Vale só para esta página; tela cheia fica sem moldura.
                        </MudText>
                    </MudPaper>
                }
            </div>
        </MudItem>

        @* Linha das páginas: largura toda, embaixo do Canvas e do painel do widget. *@
        <MudItem xs="12">
            <MudPaper Class="pa-3" Outlined="true">
                @* Páginas: miniaturas ao vivo; em cada uma, renomear no rótulo, mudar de lugar e excluir. *@
                <MudText Typo="Typo.overline" Color="Color.Secondary">Páginas</MudText>
                <div class="owd-pages">
                    @for (var i = 0; i < Dashboard.Layout.Pages.Count; i++)
                    {
                        var index = i;
                        var thumb = Dashboard.Layout.Pages[index];
                        <div @key="thumb.Id" class="owd-page-card @(index == _page ? "selected" : "")">
                            <div class="owd-thumb-grid" style="@PageStyle(thumb)" role="button" tabindex="0" @onclick="() => SelectPage(index)" title="Mostrar @thumb.Name">
                                @foreach (var w in thumb.Widgets)
                                {
                                    <div @key="w.InstanceId" class="owd-thumb-widget"
                                         style="grid-column: @(w.Column + 2) / span @w.Size.Columns; grid-row: @(w.Row + 2) / span @w.Size.Rows; @TileStyle(w, thumb)">
                                        <div class="owd-tile"><WidgetLiveFrame Dashboard="Dashboard" InstanceId="w.InstanceId" MaxPerSecond="1" /></div>
                                    </div>
                                }
                            </div>
                            @if (_renamingPage == index)
                            {
                                <MudTextField T="string" @bind-Value="_pageNameDraft" Immediate="true" AutoFocus="true" OnKeyDown="PageNameKey"
                                              Error="@(_pageNameError is not null)" ErrorText="@_pageNameError"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="owd-page-name-edit" />
                                <div class="owd-page-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" OnClick="SaveRename" aria-label="Salvar nome" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelRename" aria-label="Cancelar" />
                                </div>
                            }
                            else
                            {
                                <div class="owd-page-name" title="Duplo clique para renomear" @ondblclick="() => StartRename(index)">
                                    @if (index == Dashboard.CurrentPage)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Monitor" Size="Size.Small" title="No aparelho agora" />
                                    }
                                    <span class="owd-ellipsis">@thumb.Name</span>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="owd-page-pen"
                                                   OnClick="() => StartRename(index)" aria-label="@($"Renomear {thumb.Name}")" />
                                </div>
                                <div class="owd-page-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(index == 0)"
                                                   OnClick="() => MovePage(index, -1)" aria-label="@($"Mover {thumb.Name} para a esquerda")" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(index == Dashboard.Layout.Pages.Count - 1)"
                                                   OnClick="() => MovePage(index, 1)" aria-label="@($"Mover {thumb.Name} para a direita")" />
                                    <MudSpacer />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                   Disabled="@(Dashboard.Layout.Pages.Count < 2)"
                                                   OnClick="() => RemovePage(index)" aria-label="@($"Excluir {thumb.Name}")" />
                                </div>
                            }
                        </div>
                    }
                    <button type="button" class="owd-page-card owd-page-add" @onclick="AddPage" title="Nova página">
                        <div class="owd-thumb-grid"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" /></div>
                        <div class="owd-page-name">Nova página</div>
                    </button>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private static string ProblemTitle(WidgetProblem problem) => problem.Kind switch
    {
        WidgetProblemKind.NotInstalled => "Plugin removido",
        WidgetProblemKind.PluginFailed when problem.Reason?.Contains("SDK", StringComparison.Ordinal) == true => "Não funciona nesta versão",
        WidgetProblemKind.PluginFailed => "Plugin não carregou",
        _ => "Widget com erro",
    };

    private static string ProblemDetail(WidgetProblem problem) => problem.Kind switch
    {
        WidgetProblemKind.NotInstalled when problem.PluginFolder is { } folder =>
            $"O plugin {folder} não está mais instalado. Reinstale pela Loja ou tire este widget da página; as configurações dele ficam guardadas até lá.",
        WidgetProblemKind.NotInstalled => "O plugin deste widget não está instalado. Instale pela Loja ou tire este widget da página.",
        WidgetProblemKind.PluginFailed => $"O plugin {problem.PluginFolder} está instalado, mas não carregou nesta versão do OpenWigiDash: {problem.Reason}",
        _ => problem.Reason ?? "O widget deu erro ao abrir.",
    };

    // Nome que o widget tinha: o da instância, senão o do tipo (lembrado de quando ele carregou).
    private static string ProblemWidget(WidgetPlacement placement, WidgetProblem problem) =>
        placement.Name is { Length: > 0 } name ? name : problem.WidgetName ?? "Widget desconhecido";

    private static string ProblemPlugin(WidgetProblem problem) =>
        problem.PluginFolder is { } folder ? $"plugin {folder}" : "plugin desconhecido";

    // A Loja já abre procurando o plugin, com o botão de instalar ou atualizar no card dele.
    private static string StoreLink(WidgetProblem problem) =>
        problem.PluginFolder is { } folder ? $"/loja?busca={Uri.EscapeDataString(folder)}" : "/loja";

    private bool _updatingPlugin;

    private async Task UpdatePlugin(string packageId)
    {
        _updatingPlugin = true;
        try
        {
            var result = await Store.UpdateAsync(packageId);
            Snackbar.Add(result is null ? $"{packageId} já está na versão mais nova." : $"{packageId} atualizado para {result.Version}. O widget volta quando o manager reabrir.",
                result is null ? Severity.Info : Severity.Success);
        }
        catch (OpenWigi.Plugins.PluginInstallException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex) when (ex is System.Net.Http.HttpRequestException or TaskCanceledException)
        {
            Snackbar.Add($"Não foi possível baixar {packageId}: sem conexão com o nuget.org.", Severity.Error);
        }
        catch (Exception ex) when (ex is System.IO.IOException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Não foi possível gravar os arquivos de {packageId}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _updatingPlugin = false;
        }
    }

    private string DeviceLabel => Agent.Device switch
    {
        { Kind: DeviceKind.Virtual } => "WigiDash virtual",
        { Connected: true } => "WigiDash conectado",
        _ => "Desconectado",
    };

    // A página do editor é a do aparelho: escolher aqui troca lá, e swipe lá (ou na prévia) troca aqui.
    private int _page => Dashboard.CurrentPage;
    private Guid? _selected;

    // Aba do painel do widget (0 = Geral, 1 = Configurações); fica a mesma ao trocar de widget.
    private int _sideTab;

    private DashboardHost Dashboard => Agent.Dashboard;
    private LayoutPage? CurrentPage => Dashboard.Layout.Pages.ElementAtOrDefault(_page);
    private WidgetPlacement? Selected => CurrentPage?.Widgets.FirstOrDefault(w => w.InstanceId == _selected);

    protected override void OnInitialized()
    {
        Dashboard.LayoutChanged += Refresh;
        Dashboard.PageChanged += OnPageChanged;
        Agent.Changed += Refresh;
        Settings.Changed += Refresh;
        Store.Changed += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnPageChanged() => InvokeAsync(() =>
    {
        if (Selected is null)
            _selected = null;
        StateHasChanged();
    });

    private async Task SelectPage(int page)
    {
        _selected = null;
        await Dashboard.GoToPageAsync(page, OpenWigi.Device.Protocol.Transition.None);
    }

    private IEnumerable<(int Column, int Row)> FreeCells()
    {
        for (var row = 0; row < WidgetGrid.Rows; row++)
            for (var column = 0; column < WidgetGrid.Columns; column++)
                if (CurrentPage is null || !CurrentPage.Widgets.Any(w => w.Overlaps(column, row, WidgetSize.Mini)))
                    yield return (column, row);
    }

    // Fundo da página no editor e na miniatura: a mesma cor do aparelho.
    private static string PageStyle(LayoutPage? page) =>
        page is null ? "" : $"--owd-page-bg: {page.Frame.Background}";

    // Moldura do tile em pixels do aparelho; o CSS converte para a escala da grade (--owd-px).
    private static string TileStyle(WidgetPlacement placement, LayoutPage? page)
    {
        var shape = new TileShape(placement.Bounds, page?.Frame ?? TileFrame.Default);
        var frame = shape.Frame!;
        return $"--owd-spacing: {frame.Spacing}; --owd-border: {frame.Border}; --owd-radius: {shape.OuterRadius}; --owd-border-color: {frame.BorderColor}";
    }

    private Task SetFrame(TileFrame frame) => Dashboard.SetPageFrameAsync(_page, frame);

    private Task SetColor(ChangeEventArgs e, Func<TileFrame, WidgetColor, TileFrame> apply) =>
        CurrentPage is { } page && ParseColor(e.Value as string) is { } color
            ? SetFrame(apply(page.Frame, color))
            : Task.CompletedTask;

    private static WidgetColor? ParseColor(string? text) =>
        text is { Length: 7 } && text[0] == '#' && uint.TryParse(text.AsSpan(1), System.Globalization.NumberStyles.HexNumber, null, out var rgb)
            ? new WidgetColor((byte)(rgb >> 16), (byte)(rgb >> 8), (byte)rgb)
            : null;

    private async Task OpenAddWidget()
    {
        if (CurrentPage is not { } page)
            return;
        var parameters = new DialogParameters<AddWidgetDialog>
        {
            { d => d.Widgets, Dashboard.AvailableWidgets },
            { d => d.Page, page },
            { d => d.NameOf, id => Dashboard.DisplayNameOf(id) },
            { d => d.Dashboard, Dashboard },
            { d => d.IconOf, async id => await Dashboard.GetCatalogIconAsync(id) is { } frame ? PreviewImage.ToDataUrl(frame) : null },
        };
        var dialog = await Dialogs.ShowAsync<AddWidgetDialog>("Adicionar widget", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: AddWidgetDialog.Choice choice })
        {
            var id = await Dashboard.AddWidgetAsync(choice.WidgetId, _page, choice.Size, at: (choice.Column, choice.Row));
            if (id is null)
                Snackbar.Add("O widget não coube no lugar escolhido.", Severity.Warning);
            _selected = id;
        }
    }

    private IReadOnlyList<WidgetSize> SizesOf(Guid widgetId) =>
        Dashboard.AvailableWidgets.FirstOrDefault(w => w.Manifest.Id == widgetId)?.Manifest.SupportedSizes ?? [];

    private bool FitsAt(WidgetPlacement placement, int column, int row, WidgetSize size) =>
        column + size.Columns <= WidgetGrid.Columns && row + size.Rows <= WidgetGrid.Rows &&
        CurrentPage?.Widgets.Any(w => w != placement && w.Overlaps(column, row, size)) != true;

    private async Task Resize(Guid instanceId, WidgetSize size)
    {
        if (!await Dashboard.ResizeWidgetAsync(instanceId, size))
            Snackbar.Add("Esse tamanho não cabe a partir da posição atual.", Severity.Warning);
    }

    // Tirar apaga as configurações e os arquivos da instância: sempre pergunta antes.
    private async Task Remove(Guid instanceId)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Tirar widget",
            $"Tirar \"{Dashboard.DisplayNameOf(instanceId)}\" desta página? As configurações dele serão apagadas.",
            yesText: "Tirar", cancelText: "Cancelar");
        if (confirmed != true)
            return;
        await Dashboard.RemoveWidgetAsync(instanceId);
        _selected = null;
    }

    // --- arrastar

    private const double DragThreshold = 6; // px antes de virar arraste; menos que isso é clique
    private ElementReference _grid;
    private WidgetPlacement? _pressed;
    private WidgetPlacement? _dragging;
    private (double X, double Y) _pressAt;
    private double[] _gridRect = [0, 0, 1, 1];
    private (int Column, int Row) _grab;
    private (int Column, int Row)? _hover;
    private bool _render = true;

    // Só redesenha quando algo visível mudou (o pointermove chega muitas vezes por segundo).
    protected override bool ShouldRender()
    {
        var render = _render;
        _render = true;
        return render;
    }

    private async Task Press(WidgetPlacement placement, PointerEventArgs e)
    {
        if (e.Button != 0)
            return;
        _pressed = placement;
        _pressAt = (e.ClientX, e.ClientY);
        _gridRect = await JS.InvokeAsync<double[]>("owd.rect", _grid);
        _render = false;
    }

    // --- redimensionar pela alça do canto

    private WidgetPlacement? _resizing;
    private WidgetSize? _resizeTo;

    private async Task StartResize(WidgetPlacement placement, PointerEventArgs e)
    {
        if (e.Button != 0)
            return;
        _gridRect = await JS.InvokeAsync<double[]>("owd.rect", _grid);
        _resizing = placement;
        _resizeTo = placement.Size;
        _selected = placement.InstanceId;
    }

    // O canto vai até a célula sob o ponteiro; o tamanho é contado a partir do canto superior esquerdo.
    private void ResizeMove(PointerEventArgs e)
    {
        var placement = _resizing!;
        var (column, row) = CellAt(e.ClientX, e.ClientY);
        var size = new WidgetSize(Math.Max(1, column - placement.Column + 1), Math.Max(1, row - placement.Row + 1));
        _render = _resizeTo != size;
        _resizeTo = size;
    }

    private bool ResizeAllowed(WidgetPlacement placement, WidgetSize size) =>
        SizesOf(placement.WidgetId).Contains(size) && FitsAt(placement, placement.Column, placement.Row, size);

    private async Task ResizeRelease()
    {
        var (placement, size) = (_resizing!, _resizeTo);
        _resizing = null;
        _resizeTo = null;
        if (size is { } s && s != placement.Size)
        {
            if (ResizeAllowed(placement, s))
                await Dashboard.ResizeWidgetAsync(placement.InstanceId, s);
            else
                Snackbar.Add($"O widget não tem o tamanho {s} ou ele não cabe ali.", Severity.Warning);
        }
    }

    private void Move(PointerEventArgs e)
    {
        _render = false;
        if (_resizing is not null)
        {
            ResizeMove(e);
            return;
        }
        if (_pressed is null)
            return;

        if (_dragging is null)
        {
            if (Math.Abs(e.ClientX - _pressAt.X) < DragThreshold && Math.Abs(e.ClientY - _pressAt.Y) < DragThreshold)
                return;
            _dragging = _pressed;
            _selected = _pressed.InstanceId;
            var (pressColumn, pressRow) = CellAt(_pressAt.X, _pressAt.Y);
            _grab = (pressColumn - _pressed.Column, pressRow - _pressed.Row);
            _render = true;
        }

        // A célula sob o mouse menos a célula do widget onde a pessoa pegou = canto do encaixe.
        var (column, row) = CellAt(e.ClientX, e.ClientY);
        var hover = (column - _grab.Column, row - _grab.Row);
        if (_hover != hover)
        {
            _hover = hover;
            _render = true;
        }
    }

    private async Task Release(PointerEventArgs e)
    {
        if (_resizing is not null)
        {
            await ResizeRelease();
            return;
        }
        var wasDragging = _dragging is not null;
        await Drop();
        _pressed = null;
        _render = wasDragging;
    }

    private void Cancel()
    {
        _render = _dragging is not null || _resizing is not null;
        _resizing = null;
        _resizeTo = null;
        _pressed = null;
        EndDrag();
    }

    private (int Column, int Row) CellAt(double clientX, double clientY)
    {
        var (x, y, width, height) = (_gridRect[0], _gridRect[1], Math.Max(1, _gridRect[2]), Math.Max(1, _gridRect[3]));
        // Em pixels do aparelho; a célula é a última que começa antes do ponteiro (folga e espaço contam
        // para a célula vizinha).
        var deviceX = (clientX - x) * WidgetGrid.Screen.Width / width;
        var deviceY = (clientY - y) * WidgetGrid.Screen.Height / height;
        var column = 0;
        while (column + 1 < WidgetGrid.Columns && WidgetGrid.ColumnX(column + 1) <= deviceX)
            column++;
        var row = 0;
        while (row + 1 < WidgetGrid.Rows && WidgetGrid.RowY(row + 1) <= deviceY)
            row++;
        return (column, row);
    }

    private void EndDrag()
    {
        _dragging = null;
        _hover = null;
    }

    private bool Fits(WidgetPlacement placement, (int Column, int Row) at) =>
        at.Column >= 0 && at.Row >= 0 &&
        at.Column + placement.Size.Columns <= WidgetGrid.Columns && at.Row + placement.Size.Rows <= WidgetGrid.Rows &&
        CurrentPage?.Widgets.Any(w => w != placement && w.Overlaps(at.Column, at.Row, placement.Size)) != true;

    // Solto em cima de um único widget do mesmo tamanho (o resto da área livre): troca com ele.
    private WidgetPlacement? SwapTarget(WidgetPlacement placement, (int Column, int Row) at)
    {
        var column = Math.Clamp(at.Column, 0, WidgetGrid.Columns - placement.Size.Columns);
        var row = Math.Clamp(at.Row, 0, WidgetGrid.Rows - placement.Size.Rows);
        var under = CurrentPage?.Widgets.Where(w => w != placement && w.Overlaps(column, row, placement.Size)).ToList();
        return under is [var other] && other.Size == placement.Size ? other : null;
    }

    private async Task Drop()
    {
        if (_dragging is { } placement && _hover is { } at)
        {
            if (Fits(placement, at) && (at.Column, at.Row) != (placement.Column, placement.Row))
                await Dashboard.MoveWidgetAsync(placement.InstanceId, at.Column, at.Row);
            else if (!Fits(placement, at) && SwapTarget(placement, at) is { } other)
                await Dashboard.SwapWidgetsAsync(placement.InstanceId, other.InstanceId);
        }
        EndDrag();
    }

    private async Task AddPage() =>
        await SelectPage(await Dashboard.AddPageAsync());

    private Task MovePage(int index, int delta)
    {
        CancelRename();
        return Dashboard.MovePageAsync(index, index + delta);
    }

    // Página com widgets só sai depois do aceite: ela leva os widgets e as configurações deles junto.
    private async Task RemovePage(int index)
    {
        if (Dashboard.Layout.Pages.ElementAtOrDefault(index) is not { } page)
            return;
        var count = page.Widgets.Count;
        if (count > 0)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                "Excluir página",
                (MarkupString)($"A página <b>{System.Net.WebUtility.HtmlEncode(page.Name)}</b> tem {count} widget(s). " +
                "Excluir apaga a página, os widgets dela e as configurações deles. Isso não dá para desfazer."),
                yesText: "Excluir com os widgets", cancelText: "Cancelar");
            if (confirmed != true)
                return;
        }
        if (_renamingPage == index)
            CancelRename();
        _selected = null;
        await Dashboard.RemovePageAsync(index, withWidgets: count > 0);
    }

    // Página sendo renomeada no carrossel (null = nenhuma) e o texto em edição.
    private int? _renamingPage;
    private string? _pageNameDraft;
    private string? _pageNameError;

    private void StartRename(int index)
    {
        _renamingPage = index;
        _pageNameDraft = Dashboard.Layout.Pages.ElementAtOrDefault(index)?.Name ?? string.Empty;
        _pageNameError = null;
    }

    private void CancelRename()
    {
        _renamingPage = null;
        _pageNameDraft = null;
        _pageNameError = null;
    }

    // Nome vazio ou de outra página não grava: o campo fica aberto com o motivo para corrigir.
    private async Task SaveRename()
    {
        if (_renamingPage is not { } index)
            return;
        var name = _pageNameDraft ?? string.Empty;
        if (string.IsNullOrWhiteSpace(name))
            _pageNameError = "A página precisa de um nome";
        else if (Dashboard.IsPageNameTaken(name, index))
            _pageNameError = "Já existe uma página com esse nome";
        else if (name.Trim() == Dashboard.Layout.Pages.ElementAtOrDefault(index)?.Name || await Dashboard.RenamePageAsync(index, name))
            CancelRename();
        else
            _pageNameError = "Não deu para renomear";
    }

    private async Task PageNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SaveRename();
        else if (e.Key == "Escape")
            CancelRename();
    }
    // Delete com um widget selecionado = "Tirar" (com a mesma confirmação).
    private DotNetObjectReference<Widgets>? _self;
    private IJSObjectReference? _deleteKey;
    private IJSObjectReference? _fitCanvas;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _deleteKey = await JS.InvokeAsync<IJSObjectReference>("owd.onDeleteKey", _self);
            _fitCanvas = await JS.InvokeAsync<IJSObjectReference>("owd.fitCanvas", _grid);
        }
    }

    [JSInvokable]
    public async Task DeletePressed()
    {
        if (Selected is { } selected && _dragging is null)
            await Remove(selected.InstanceId);
    }

    public async ValueTask DisposeAsync()
    {
        Dashboard.LayoutChanged -= Refresh;
        Dashboard.PageChanged -= OnPageChanged;
        Agent.Changed -= Refresh;
        Settings.Changed -= Refresh;
        Store.Changed -= Refresh;
        try
        {
            if (_deleteKey is not null)
            {
                await _deleteKey.InvokeVoidAsync("dispose");
                await _deleteKey.DisposeAsync();
            }
            if (_fitCanvas is not null)
            {
                await _fitCanvas.InvokeVoidAsync("dispose");
                await _fitCanvas.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        _self?.Dispose();
    }
}
