@page "/widgets"
@implements IDisposable
@inject AgentClient Agent
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h5">Widgets e páginas</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Monte cada página na grade 5x4 do WigiDash. Selecione um widget para movê-lo, configurar ou tirar.
        </MudText>
    </div>

    @if (Dashboard.PluginErrors.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            @Dashboard.PluginErrors.Count plugin(s) não carregaram:
            @string.Join("; ", Dashboard.PluginErrors.Select(e => $"{System.IO.Path.GetFileName(e.PluginDirectory)}: {e.Reason}"))
        </MudAlert>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudChipSet T="int" SelectedValue="_page" SelectedValueChanged="SelectPage" SelectionMode="SelectionMode.SingleSelection" CheckMark="false">
            @for (var i = 0; i < Dashboard.Layout.Pages.Count; i++)
            {
                var index = i;
                <MudChip T="int" Value="index" Color="Color.Primary" Variant="Variant.Outlined">@Dashboard.Layout.Pages[index].Name</MudChip>
            }
        </MudChipSet>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" OnClick="AddPage">Nova página</MudButton>
        <MudSpacer />
        <MudTextField T="string" Value="CurrentPage?.Name" ValueChanged="RenamePage" Label="Nome da página" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="max-width: 240px" DebounceInterval="400" />
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Text"
                   Disabled="@(Dashboard.Layout.Pages.Count < 2 || CurrentPage?.Widgets.Count > 0)" OnClick="RemovePage">
            Excluir página vazia
        </MudButton>
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="8">
            @* Arrastar com eventos de ponteiro, não com o drag and drop do HTML: o WebView2 do WPF (controle
               de composição) não entrega o arrastar nativo do Windows, e por RDP ele simplesmente não acontece. *@
            <div class="owd-grid @(_dragging is null ? "" : "dragging")" @ref="_grid"
                 @onpointermove="Move" @onpointerup="Release" @onpointerleave="Cancel">
                @foreach (var cell in FreeCells())
                {
                    <div class="owd-cell-empty" style="grid-column: @(cell.Column + 1); grid-row: @(cell.Row + 1)"
                         @onclick="() => MoveSelectedTo(cell.Column, cell.Row)"></div>
                }
                @foreach (var placement in CurrentPage?.Widgets ?? [])
                {
                    var p = placement;
                    <div class="owd-widget @(p.InstanceId == _selected ? "selected" : "") @(p.InstanceId == _dragging?.InstanceId ? "ghost" : "")"
                         style="grid-column: @(p.Column + 1) / span @p.Size.Columns; grid-row: @(p.Row + 1) / span @p.Size.Rows"
                         @onpointerdown="e => Press(p, e)"
                         @onclick="() => _selected = p.InstanceId">
                        <MudText Typo="Typo.subtitle2">@(Dashboard.NameOf(p.InstanceId) ?? "Widget não instalado")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@p.Size</MudText>
                    </div>
                }

                @if (_dragging is { } dragged)
                {
                    if (_hover is { } target)
                    {
                        var c = Math.Clamp(target.Column, 0, WidgetGrid.Columns - dragged.Size.Columns);
                        var r = Math.Clamp(target.Row, 0, WidgetGrid.Rows - dragged.Size.Rows);
                        <div class="owd-drop @(Fits(dragged, target) ? "ok" : "bad")"
                             style="grid-column: @(c + 1) / span @dragged.Size.Columns; grid-row: @(r + 1) / span @dragged.Size.Rows"></div>
                    }
                }
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                Arraste um widget para outra posição: a área verde mostra onde ele encaixa (vermelha = não cabe).
            </MudText>
        </MudItem>

        <MudItem xs="12" md="4">
            @if (Selected is { } selected)
            {
                <MudPaper Class="pa-4 mb-4" Outlined="true">
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Selecionado</MudText>
                    <MudText Typo="Typo.h6">@(Dashboard.NameOf(selected.InstanceId) ?? "Widget não instalado")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Coluna @(selected.Column + 1), linha @(selected.Row + 1), tamanho @selected.Size</MudText>
                    @if (SizesOf(selected.WidgetId) is { Count: > 1 } sizes)
                    {
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-3 d-block">Tamanho (colunas × linhas)</MudText>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var size in sizes)
                            {
                                var s = size;
                                var fits = FitsAt(selected, selected.Column, selected.Row, s);
                                <MudChip T="string" Size="Size.Small" Variant="@(s == selected.Size ? Variant.Filled : Variant.Outlined)"
                                         Color="@(s == selected.Size ? Color.Primary : Color.Default)" Disabled="@(!fits && s != selected.Size)"
                                         OnClick="() => Resize(selected.InstanceId, s)">@s</MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Tamanhos apagados não cabem a partir desta posição: mova o widget antes.</MudText>
                    }
                    <MudStack Row="true" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings"
                                   Disabled="@(Dashboard.GetSettings(selected.InstanceId) is null)"
                                   OnClick="@(() => Navigation.NavigateTo($"/widgets/{selected.InstanceId}"))">Configurar</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="() => Remove(selected.InstanceId)">Tirar</MudButton>
                    </MudStack>
                </MudPaper>
            }

            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Adicionar nesta página</MudText>
                @if (Dashboard.AvailableWidgets.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Nenhum widget instalado. Copie a pasta do plugin para %LOCALAPPDATA%\OpenWigiDash\Widgets e reabra o manager.
                    </MudText>
                }
                @* Um botão por tamanho que o widget suporta; apagado quando não há espaço livre para ele nesta página. *@
                @foreach (var widget in Dashboard.AvailableWidgets)
                {
                    var w = widget;
                    <div class="mt-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Widgets" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">@w.Manifest.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">v@(w.Manifest.Version)</MudText>
                        </MudStack>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var size in w.Manifest.SupportedSizes)
                            {
                                var s = size;
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                         Disabled="@(CurrentPage?.FindFreeCell(s) is null)" Icon="@Icons.Material.Filled.Add"
                                         OnClick="() => Add(w.Manifest.Id, s)">@s</MudChip>
                            }
                        </div>
                    </div>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 d-block">
                    Clique no tamanho (colunas × linhas) para pôr o widget na primeira posição livre; depois arraste para onde quiser.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private int _page;
    private Guid? _selected;

    private DashboardHost Dashboard => Agent.Dashboard;
    private LayoutPage? CurrentPage => Dashboard.Layout.Pages.ElementAtOrDefault(_page);
    private WidgetPlacement? Selected => CurrentPage?.Widgets.FirstOrDefault(w => w.InstanceId == _selected);

    protected override void OnInitialized()
    {
        _page = Dashboard.CurrentPage;
        Dashboard.LayoutChanged += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task SelectPage(int page)
    {
        _page = page;
        _selected = null;
        await Dashboard.GoToPageAsync(page, OpenWigi.Device.Protocol.Transition.None);
    }

    private IEnumerable<(int Column, int Row)> FreeCells()
    {
        for (var row = 0; row < WidgetGrid.Rows; row++)
            for (var column = 0; column < WidgetGrid.Columns; column++)
                if (CurrentPage is null || !CurrentPage.Widgets.Any(w => w.Overlaps(column, row, WidgetSize.Small)))
                    yield return (column, row);
    }

    private async Task Add(Guid widgetId, WidgetSize size)
    {
        var id = await Dashboard.AddWidgetAsync(widgetId, _page, size);
        if (id is null)
            Snackbar.Add("Não há espaço livre nesta página para esse tamanho.", Severity.Warning);
        _selected = id;
    }

    private IReadOnlyList<WidgetSize> SizesOf(Guid widgetId) =>
        Dashboard.AvailableWidgets.FirstOrDefault(w => w.Manifest.Id == widgetId)?.Manifest.SupportedSizes ?? [];

    private bool FitsAt(WidgetPlacement placement, int column, int row, WidgetSize size) =>
        column + size.Columns <= WidgetGrid.Columns && row + size.Rows <= WidgetGrid.Rows &&
        CurrentPage?.Widgets.Any(w => w != placement && w.Overlaps(column, row, size)) != true;

    private async Task Resize(Guid instanceId, WidgetSize size)
    {
        if (!await Dashboard.ResizeWidgetAsync(instanceId, size))
            Snackbar.Add("Esse tamanho não cabe a partir da posição atual.", Severity.Warning);
    }

    private async Task Remove(Guid instanceId)
    {
        await Dashboard.RemoveWidgetAsync(instanceId);
        _selected = null;
    }

    // --- arrastar

    private const double DragThreshold = 6; // px antes de virar arraste; menos que isso é clique
    private ElementReference _grid;
    private WidgetPlacement? _pressed;
    private WidgetPlacement? _dragging;
    private (double X, double Y) _pressAt;
    private double[] _gridRect = [0, 0, 1, 1];
    private (int Column, int Row) _grab;
    private (int Column, int Row)? _hover;
    private bool _render = true;

    // Só redesenha quando algo visível mudou (o pointermove chega muitas vezes por segundo).
    protected override bool ShouldRender()
    {
        var render = _render;
        _render = true;
        return render;
    }

    private async Task Press(WidgetPlacement placement, PointerEventArgs e)
    {
        if (e.Button != 0)
            return;
        _pressed = placement;
        _pressAt = (e.ClientX, e.ClientY);
        _gridRect = await JS.InvokeAsync<double[]>("owd.rect", _grid);
        _render = false;
    }

    private void Move(PointerEventArgs e)
    {
        _render = false;
        if (_pressed is null)
            return;

        if (_dragging is null)
        {
            if (Math.Abs(e.ClientX - _pressAt.X) < DragThreshold && Math.Abs(e.ClientY - _pressAt.Y) < DragThreshold)
                return;
            _dragging = _pressed;
            _selected = _pressed.InstanceId;
            var (pressColumn, pressRow) = CellAt(_pressAt.X, _pressAt.Y);
            _grab = (pressColumn - _pressed.Column, pressRow - _pressed.Row);
            _render = true;
        }

        // A célula sob o mouse menos a célula do widget onde a pessoa pegou = canto do encaixe.
        var (column, row) = CellAt(e.ClientX, e.ClientY);
        var hover = (column - _grab.Column, row - _grab.Row);
        if (_hover != hover)
        {
            _hover = hover;
            _render = true;
        }
    }

    private async Task Release(PointerEventArgs e)
    {
        var wasDragging = _dragging is not null;
        await Drop();
        _pressed = null;
        _render = wasDragging;
    }

    private void Cancel()
    {
        _render = _dragging is not null;
        _pressed = null;
        EndDrag();
    }

    private (int Column, int Row) CellAt(double clientX, double clientY)
    {
        var (x, y, width, height) = (_gridRect[0], _gridRect[1], Math.Max(1, _gridRect[2]), Math.Max(1, _gridRect[3]));
        return (Math.Clamp((int)((clientX - x) / (width / WidgetGrid.Columns)), 0, WidgetGrid.Columns - 1),
            Math.Clamp((int)((clientY - y) / (height / WidgetGrid.Rows)), 0, WidgetGrid.Rows - 1));
    }

    private void EndDrag()
    {
        _dragging = null;
        _hover = null;
    }

    private bool Fits(WidgetPlacement placement, (int Column, int Row) at) =>
        at.Column >= 0 && at.Row >= 0 &&
        at.Column + placement.Size.Columns <= WidgetGrid.Columns && at.Row + placement.Size.Rows <= WidgetGrid.Rows &&
        CurrentPage?.Widgets.Any(w => w != placement && w.Overlaps(at.Column, at.Row, placement.Size)) != true;

    private async Task Drop()
    {
        if (_dragging is { } placement && _hover is { } at && Fits(placement, at)
            && (at.Column, at.Row) != (placement.Column, placement.Row))
            await Dashboard.MoveWidgetAsync(placement.InstanceId, at.Column, at.Row);
        EndDrag();
    }

    private async Task MoveSelectedTo(int column, int row)
    {
        if (_selected is { } id && !await Dashboard.MoveWidgetAsync(id, column, row))
            Snackbar.Add("O widget não cabe a partir dessa célula.", Severity.Warning);
    }

    private async Task AddPage() =>
        await SelectPage(await Dashboard.AddPageAsync($"Página {Dashboard.Layout.Pages.Count + 1}"));

    private async Task RemovePage()
    {
        if (await Dashboard.RemovePageAsync(_page))
            _page = Math.Min(_page, Dashboard.Layout.Pages.Count - 1);
    }

    private async Task RenamePage(string name)
    {
        if (!string.IsNullOrWhiteSpace(name))
            await Dashboard.RenamePageAsync(_page, name.Trim());
    }

    public void Dispose() => Dashboard.LayoutChanged -= Refresh;
}
