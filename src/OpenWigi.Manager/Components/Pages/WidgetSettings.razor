@page "/widgets/{InstanceId:guid}"
@inject AgentClient Agent
@inject NavigationManager Navigation

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/widgets"))" aria-label="Voltar" />
        <MudText Typo="Typo.h5">@(Agent.Dashboard.NameOf(InstanceId) ?? "Widget")</MudText>
    </MudStack>

    @if (_settings is { } s)
    {
        <MudPaper Class="pa-4" Outlined="true">
            @* Tela de configurações do próprio plugin (Razor + MudBlazor), com a instância e o contexto. *@
            <CascadingValue Value="s.Context">
                <DynamicComponent Type="s.Component" Parameters="@(new Dictionary<string, object> { ["Instance"] = s.Instance })" />
            </CascadingValue>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Info">Este widget não tem tela de configurações.</MudAlert>
    }
</MudStack>

@code {
    [Parameter] public Guid InstanceId { get; set; }

    private (Type Component, IWidgetInstance Instance, IWidgetContext Context)? _settings;

    protected override void OnParametersSet() => _settings = Agent.Dashboard.GetSettings(InstanceId);
}
