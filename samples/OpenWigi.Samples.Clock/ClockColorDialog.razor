@using MudBlazor
@using MudBlazor.Utilities

@* Seletor de cor do relógio. Abre pelo IDialogService, que desenha na raiz da página: o MudColorPicker
   comum abre um popover dentro do painel de configurações, que ficava atrás dos cantos dos widgets do canvas.
   Devolve a MudColor escolhida. *@
<MudDialog>
    <DialogContent>
        <MudColorPicker @bind-Value="_color" PickerVariant="PickerVariant.Static" ShowAlpha="false"
                        ColorPickerView="ColorPickerView.Spectrum" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(_color))">Usar esta cor</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Cor que o seletor mostra ao abrir.</summary>
    [Parameter] public MudColor Initial { get; set; } = new(255, 255, 255, 255);

    private MudColor _color = new(255, 255, 255, 255);

    protected override void OnInitialized() => _color = Initial;
}
