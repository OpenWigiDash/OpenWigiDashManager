<Project Sdk="Microsoft.NET.Sdk">

  <!-- Widget de exemplo: relógio e contador com long-press. Mostra como um plugin referencia o SDK
       sem levar cópia dele (o host carrega uma só). -->
  <PropertyGroup>
    <RootNamespace>OpenWigi.Samples.Clock</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenWigi.Sdk\OpenWigi.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

</Project>
