<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Widget de exemplo: relógio e contador com long-press. Mostra como um plugin referencia o SDK
       e o MudBlazor sem levar cópia deles (o host carrega uma só), e como entregar a tela de
       configurações em Razor. -->
  <PropertyGroup>
    <RootNamespace>OpenWigi.Samples.Clock</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenWigi.Sdk\OpenWigi.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.11.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
