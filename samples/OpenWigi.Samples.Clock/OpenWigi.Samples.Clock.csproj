<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Widget de exemplo: relógio e contador com long-press. Mostra como um plugin referencia o SDK
       e o MudBlazor sem levar cópia deles (o host carrega uma só), e como entregar a tela de
       configurações em Razor. -->
  <PropertyGroup>
    <RootNamespace>OpenWigi.Samples.Clock</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- `dotnet pack` gera o pacote de plugin (ver docs/sdk.md, "Publicar no nuget.org"). -->
    <OpenWigiDashPlugin>true</OpenWigiDashPlugin>
    <!-- Enquanto o SDK for preview, o plugin também é (NU5104: versão estável não depende de preview). -->
    <Version>1.0.0-preview.1</Version>
    <Description>Widget de exemplo do OpenWigiDash: relógio e contador com long-press.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenWigi.Sdk\OpenWigi.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.11.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Pelo pacote, o NuGet importa este arquivo sozinho; pela referência de projeto, importamos à mão. -->
  <Import Project="..\..\src\OpenWigi.Sdk\build\victorperez2911.OpenWigi.Sdk.targets" />

</Project>
