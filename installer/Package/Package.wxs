<!--
  OpenWigiDash: MSI por máquina.

  Program Files\OpenWigiDash
    Service\   serviço OpenWigiDash (LocalService), dono do USB
    Manager\   manager de cada usuário (tray + janela)
    Widgets\   widgets que vêm com o instalador; a pasta do usuário (%LOCALAPPDATA%) ganha de um de mesmo nome

  Upgrade in-place pela UpgradeCode (MajorUpgrade). Layout e ajustes ficam no perfil de cada usuário e
  não saem na desinstalação.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="OpenWigiDash"
           Manufacturer="Victor Perez"
           Version="$(Version)"
           UpgradeCode="36627c21-1299-4ca3-85fb-d45a6cc850b5"
           Scope="perMachine"
           Language="1046"
           Codepage="1252">

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova do OpenWigiDash já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(BrandingDir)openwigidash.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/OpenWigiDash/OpenWigiDashManager" />
    <Property Id="ARPHELPLINK" Value="https://github.com/OpenWigiDash/OpenWigiDashManager/issues" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenWigiDash">
        <Directory Id="ServiceFolder" Name="Service" />
        <Directory Id="ManagerFolder" Name="Manager" />
        <Directory Id="WidgetsFolder" Name="Widgets" />
      </Directory>
    </StandardDirectory>

    <!-- Dados do serviço (ex.: device.txt, o aparelho ativo escolhido no manager). Quem grava é o serviço,
         que roda como LocalService e não teria permissão de criar isso sozinho em todo Windows. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="OpenWigiDash">
        <Directory Id="ServiceDataFolder" Name="Service" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="OpenWigiDash" AllowAbsent="no">
      <ComponentGroupRef Id="Service" />
      <Component Id="ServiceData" Directory="ServiceDataFolder" Guid="5f5c0f4e-8a0b-4d0e-9c43-2a1f6b7d9e21">
        <!-- SDDL em vez de nomes de conta, que mudam com o idioma do Windows: sistema e admins com controle
             total, LocalService (LS) com Modify, usuários (BU) com leitura. -->
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;LS)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
      </Component>
      <ComponentGroupRef Id="Manager" />
      <Files Directory="WidgetsFolder" Include="$(PublishRoot)widgets\**" />
    </Feature>

    <!-- O manager roda em todas as sessões abertas e segura as DLLs dos widgets: fecha antes de trocar
         os arquivos (upgrade) ou de remover. Ele volta no próximo login, ou pelo atalho. -->
    <util:CloseApplication Id="CloseManager" Target="OpenWigiDashManager.exe"
                           CloseMessage="yes" RebootPrompt="no" TerminateProcess="0" Timeout="5" />
  </Package>

  <Fragment>
    <ComponentGroup Id="Service" Directory="ServiceFolder">
      <Component Id="ServiceExe">
        <File Id="OpenWigiServiceExe" Source="$(PublishRoot)service\OpenWigiService.exe" KeyPath="yes" />
        <!-- LocalService, como o de dev: o USB abre sem LocalSystem, e a pasta é só leitura para os usuários. -->
        <ServiceInstall Name="OpenWigiDash"
                        DisplayName="OpenWigiDash"
                        Description="Dono do USB do WigiDash; entrega a tela à sessão ativa."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT AUTHORITY\LocalService"
                        Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ServiceControl" Name="OpenWigiDash" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- Um serviço OpenWigiDash que não é desta instalação (o de dev do Setup-DevService.ps1, ou o
             registro que sobrou de uma desinstalação) é parado e removido antes do InstallServices, e o
             instalador registra o seu no lugar. No upgrade o antigo já saiu com a versão anterior. -->
        <ServiceControl Id="ReplaceExistingService" Name="OpenWigiDash" Stop="install" Remove="install" Wait="yes" />
        <!-- Origem do Log de Eventos que o serviço usa (Program.cs); criar exige admin. -->
        <util:EventSource Name="OpenWigiDash" Log="Application"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
      </Component>
      <Files Include="$(PublishRoot)service\**">
        <Exclude Files="$(PublishRoot)service\OpenWigiService.exe" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="Manager" Directory="ManagerFolder">
      <Component Id="ManagerExe">
        <!-- Atalho no menu Iniciar (o mesmo serve para fixar na barra de tarefas). Num pacote por máquina o
             menu Iniciar é o de todos os usuários, mas os ICE43/57 não sabem disso: ver Package.wixproj. -->
        <File Id="OpenWigiDashManagerExe" Source="$(PublishRoot)manager\OpenWigiDashManager.exe" KeyPath="yes">
          <Shortcut Id="ManagerShortcut"
                    Directory="ProgramMenuFolder"
                    Name="OpenWigiDash"
                    Description="Widgets e páginas do painel WigiDash"
                    WorkingDirectory="ManagerFolder"
                    Icon="AppIcon"
                    Advertise="no" />
        </File>
      </Component>
      <Files Include="$(PublishRoot)manager\**">
        <Exclude Files="$(PublishRoot)manager\OpenWigiDashManager.exe" />
      </Files>

      <!-- Abre com o login de todos os usuários, direto no tray. Quem desligar em Ajustes fica gravado
           no perfil dele, e o manager sai sozinho quando é aberto por esta entrada (ManagerSettings). -->
      <Component Id="Autostart">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="OpenWigiDash" Type="string"
                       Value="&quot;[ManagerFolder]OpenWigiDashManager.exe&quot; --tray --autostart" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
