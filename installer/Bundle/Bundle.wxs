<!--
  OpenWigiDash-Setup.exe: o que se baixa da release. Instala o WebView2 Runtime (só se faltar; no
  Windows 11 já vem) e o MSI. No fim, "Abrir" inicia o manager como o usuário que instalou.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="OpenWigiDash"
          Manufacturer="Victor Perez"
          Version="$(Version)"
          UpgradeCode="743de56b-2795-4f3c-a099-52059d01f3bc"
          IconSourceFile="$(BrandingDir)openwigidash.ico"
          AboutUrl="https://github.com/OpenWigiDash/OpenWigiDashManager">

    <BootstrapperApplication>
      <!-- O tema exige um link de licença: a MIT do repositório. -->
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              ThemeFile="Theme.xml"
                                              LicenseUrl="https://github.com/OpenWigiDash/OpenWigiDashManager/blob/main/LICENSE"
                                              LogoFile="$(BrandingDir)png\openwigidash-64.png"
                                              SuppressOptionsUI="yes"
                                              ShowVersion="yes" />
      <!-- Ícone da janela e da barra de tarefas durante a instalação (Window/@IconFile do Theme.xml). -->
      <Payload Name="openwigidash.ico" SourceFile="$(BrandingDir)openwigidash.ico" />
    </BootstrapperApplication>

    <!-- "Abrir" no fim do setup: abre o manager pelo explorer.exe, como um clique no menu Iniciar. Aberto
         direto pelo processo do setup, o manager não via a pasta de widgets do usuário
         (%LOCALAPPDATA%\OpenWigiDash\Widgets) e carregava só os que vêm com o instalador. -->
    <Variable Name="LaunchTarget" Value="[WindowsFolder]explorer.exe" />
    <Variable Name="LaunchArguments" Value="&quot;[ProgramFiles64Folder]OpenWigiDash\Manager\OpenWigiDashManager.exe&quot;" />

    <!-- WebView2 Evergreen: a versão instalada fica em "pv" (por máquina ou por usuário). -->
    <util:RegistrySearch Id="WebView2Machine" Root="HKLM"
                         Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                         Value="pv" Variable="WebView2MachineVersion" Bitness="always32" />
    <util:RegistrySearch Id="WebView2User" Root="HKCU"
                         Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                         Value="pv" Variable="WebView2UserVersion" />

    <Chain>
      <ExePackage Id="WebView2Runtime"
                  DisplayName="Microsoft Edge WebView2 Runtime"
                  SourceFile="$(WebView2Bootstrapper)"
                  InstallArguments="/silent /install"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  Cache="remove"
                  DetectCondition="(WebView2MachineVersion AND WebView2MachineVersion &lt;&gt; &quot;0.0.0.0&quot;) OR (WebView2UserVersion AND WebView2UserVersion &lt;&gt; &quot;0.0.0.0&quot;)" />
      <?ifdef MsiPath?>
      <MsiPackage SourceFile="$(MsiPath)" />
      <?else?>
      <MsiPackage SourceFile="$(Package.TargetPath)" />
      <?endif?>
    </Chain>
  </Bundle>

</Wix>
